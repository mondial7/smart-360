/**
 * Feedback Round List Component
 *
 * Displays all feedback rounds with filters and status
 */

import React from 'react';
import { useNavigate } from 'react-router-dom';
import {
  Paper,
  Table,
  TableBody,
  TableCell,
  TableContainer,
  TableHead,
  TableRow,
  Chip,
  Typography,
  Box,
  CircularProgress,
  Alert,
  IconButton,
  Tooltip,
} from '@mui/material';
import VisibilityIcon from '@mui/icons-material/Visibility';
import AutoAwesomeIcon from '@mui/icons-material/AutoAwesome';
import { useFeedbackRounds } from '../../hooks/useFeedbackRounds';
import type { FeedbackRoundStatus } from '../../types';

const getStatusColor = (
  status: FeedbackRoundStatus
): 'default' | 'primary' | 'success' | 'warning' => {
  switch (status) {
    case 'active':
      return 'primary';
    case 'closed':
      return 'warning';
    case 'shared':
      return 'success';
    default:
      return 'default';
  }
};

const formatDeadline = (deadline: Date): string => {
  const now = new Date();
  const diff = deadline.getTime() - now.getTime();
  const days = Math.ceil(diff / (1000 * 60 * 60 * 24));

  if (days < 0) {
    return `Overdue by ${Math.abs(days)} day${Math.abs(days) !== 1 ? 's' : ''}`;
  } else if (days === 0) {
    return 'Due today';
  } else if (days === 1) {
    return 'Due tomorrow';
  } else {
    return `${days} days left`;
  }
};

export const FeedbackRoundList: React.FC = () => {
  const { rounds, loading, error } = useFeedbackRounds();
  const navigate = useNavigate();

  if (loading) {
    return (
      <Box sx={{ display: 'flex', justifyContent: 'center', p: 4 }}>
        <CircularProgress />
      </Box>
    );
  }

  if (error) {
    return (
      <Alert severity="error">
        Error loading feedback rounds: {error.message}
      </Alert>
    );
  }

  if (rounds.length === 0) {
    return (
      <Alert severity="info">
        No feedback rounds created yet. Click "Create Round" to get started.
      </Alert>
    );
  }

  return (
    <TableContainer component={Paper}>
      <Table>
        <TableHead>
          <TableRow>
            <TableCell>Subject</TableCell>
            <TableCell>Reviewers</TableCell>
            <TableCell>Status</TableCell>
            <TableCell>Deadline</TableCell>
            <TableCell>Progress</TableCell>
            <TableCell>Created</TableCell>
            <TableCell align="center">Actions</TableCell>
          </TableRow>
        </TableHead>
        <TableBody>
          {rounds.map((round) => {
            const progress = `${round.submissionCount}/${round.reviewerIds.length}`;
            const isOverdue = new Date() > round.deadline && round.status === 'active';

            return (
              <TableRow key={round.id} hover>
                <TableCell>
                  <Typography variant="body2">{round.subjectName}</Typography>
                </TableCell>
                <TableCell>
                  <Typography variant="body2">
                    {round.reviewerIds.length} reviewer{round.reviewerIds.length !== 1 ? 's' : ''}
                  </Typography>
                </TableCell>
                <TableCell>
                  <Chip
                    label={round.status}
                    color={getStatusColor(round.status)}
                    size="small"
                  />
                </TableCell>
                <TableCell>
                  <Typography
                    variant="body2"
                    color={isOverdue ? 'error' : 'text.secondary'}
                  >
                    {round.deadline.toLocaleDateString()}
                  </Typography>
                  {round.status === 'active' && (
                    <Typography
                      variant="caption"
                      color={isOverdue ? 'error' : 'text.secondary'}
                    >
                      {formatDeadline(round.deadline)}
                    </Typography>
                  )}
                </TableCell>
                <TableCell>
                  <Tooltip title={`${round.submissionCount} of ${round.reviewerIds.length} submitted`}>
                    <Chip label={progress} size="small" variant="outlined" />
                  </Tooltip>
                </TableCell>
                <TableCell>
                  <Typography variant="body2" color="text.secondary">
                    {round.createdAt.toLocaleDateString()}
                  </Typography>
                </TableCell>
                <TableCell align="center">
                  <Tooltip title={round.consolidatedAt ? "View Consolidation" : "Consolidate Feedback"}>
                    <IconButton
                      size="small"
                      onClick={() => navigate(`/admin/rounds/${round.id}/consolidate`)}
                      color={round.consolidatedAt ? "success" : "primary"}
                    >
                      {round.consolidatedAt ? <VisibilityIcon fontSize="small" /> : <AutoAwesomeIcon fontSize="small" />}
                    </IconButton>
                  </Tooltip>
                </TableCell>
              </TableRow>
            );
          })}
        </TableBody>
      </Table>
    </TableContainer>
  );
};
