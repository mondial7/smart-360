# Node/Vue .gitignore

# Dependencies
/node_modules/
/.pnp
.pnp.js

# Build output
/dist/
/build/
/.vite/

# Local env files
.env
.env.local
.env.*.local

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor directories and files
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS
.DS_Store
Thumbs.db

# Testing
/coverage/
/.nyc_output/

# Temporary files
*.tmp
.cache/
*.tsbuildinfo
