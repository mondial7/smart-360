# MongoDB Configuration
# If using docker-compose with authentication (default)
MONGODB_URI=mongodb://admin:password123@localhost:27017
MONGODB_DB=smart360

# If using MongoDB without authentication, use this instead:
# MONGODB_URI=mongodb://localhost:27017

# OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8080/api/auth/callback

# Application Configuration
FRONTEND_URL=http://localhost:5173
JWT_SECRET=your-random-secret-key-change-in-production

# AI Configuration
GEMINI_API_KEY=your-gemini-api-key
