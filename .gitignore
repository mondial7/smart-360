# Root .gitignore for Smart 360 Feedback

# Environment files
.env
.env.local
.env.*.local

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
*.tmp

# Build artifacts
/smart360
/dist/

# Embedded frontend bundle (regenerated by `make embed`).
# Keep the .gitkeep placeholder so //go:embed compiles in fresh checkouts
# that have not yet run `make build`.
backend/web/dist/*
!backend/web/dist/.gitkeep
