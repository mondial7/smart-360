# ==========================================
# Smart 360 Feedback - Environment Configuration
# ==========================================
# Copy this file to .env and fill in your actual values
# cp .env.example .env

# ==========================================
# MongoDB Configuration
# ==========================================
# For Docker Compose installs: MONGO_ROOT_USER + MONGO_ROOT_PASSWORD are
# used to bootstrap the mongo container; the backend's MONGODB_URI is
# composed automatically from these.
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=password123
# IMPORTANT: Change the password in production!

# For Homebrew / single-binary / source installs: set MONGODB_URI directly
# to the Mongo instance you want the app to talk to. Leave the line below
# commented when running via Docker Compose.
# MONGODB_URI=mongodb://admin:password123@localhost:27017
# MONGODB_DB=smart360

# ==========================================
# Google OAuth Configuration
# ==========================================
# Get these credentials from: https://console.cloud.google.com/apis/credentials
# 1. Create a new project or select existing
# 2. Enable Google+ API
# 3. Create OAuth 2.0 credentials
# 4. Add authorized redirect URI: http://localhost:8080/api/auth/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8080/api/auth/callback

# ==========================================
# Application Configuration
# ==========================================
# Frontend URL (used for CORS)
FRONTEND_URL=http://localhost

# Frontend port (change if port 80 is already in use)
FRONTEND_PORT=80

# JWT Secret (REQUIRED — the server refuses to start without one)
# Generate with: openssl rand -base64 32
JWT_SECRET=change-this-to-a-random-secret-in-production

# Port the Go server listens on (single-binary / source installs).
# Docker Compose pins the backend port internally; ignored there.
# PORT=8080

# ==========================================
# AI Configuration
# ==========================================
# Get your Gemini API key from: https://makersuite.google.com/app/apikey
# This is required for AI-powered feedback consolidation
GEMINI_API_KEY=your-gemini-api-key

# ==========================================
# Development Options (Optional)
# ==========================================
# SECURITY WARNING: Set to 'true' ONLY in local development environments
# This enables:
#   - /api/auth/dev-login endpoint (bypasses OAuth - authentication bypass risk!)
#   - Automatic test data seeding on startup (clears existing data!)
#
# NEVER set DEV_MODE=true in production - it allows anyone to authenticate
# as any user by simply knowing their email address!
#
# For production, leave this commented out or explicitly set to false
# DEV_MODE=false
