# ==========================================
# Smart 360 Feedback - Environment Configuration
# ==========================================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
# `.env` is gitignored.

# ==========================================
# Server
# ==========================================
PORT=8080
APP_URL=http://localhost:8080

# Enables /auth/dev-login (OAuth bypass), relaxes the Secure cookie flag, and
# seeds development data on startup.
# SECURITY WARNING: NEVER set true in production — anyone could authenticate as
# any user by knowing their email. Leave false (or unset) in production.
DEV_MODE=true

# ==========================================
# Database (Postgres)
# ==========================================
# For local `go run`, point at the docker-compose Postgres below.
DATABASE_URL=postgres://smart360:smart360@localhost:5432/smart360?sslmode=disable

# docker-compose bootstrap values (compose builds DATABASE_URL from these).
POSTGRES_USER=smart360
POSTGRES_PASSWORD=smart360
POSTGRES_DB=smart360
POSTGRES_PORT=5432
# IMPORTANT: change the password in production!

# ==========================================
# Sessions
# ==========================================
# Signs/authenticates session cookies. REQUIRED in production; when DEV_MODE=true
# and this is empty, an insecure dev fallback is used.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# ==========================================
# Google OAuth
# ==========================================
# From https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must match GOOGLE_REDIRECT_URL below.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/callback

# ==========================================
# AI (optional)
# ==========================================
# Gemini API key from https://aistudio.google.com/app/apikey
# When empty, consolidation falls back to non-AI aggregation and the moderation
# pass is a no-op (originals pass through).
GEMINI_API_KEY=
